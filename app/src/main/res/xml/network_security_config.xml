<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Standaard alleen https. De server draait via Tailscale (https://…ts.net). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Uitzondering voor mDNS-namen op het thuisnetwerk (bijv. http://homeassistant.local:8095). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">local</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- Sendspin-stream van de MA-server op het thuisnetwerk (ws://192.168.1.100:8927/sendspin). -->
        <domain includeSubdomains="false">192.168.1.100</domain>
    </domain-config>
</network-security-config>
