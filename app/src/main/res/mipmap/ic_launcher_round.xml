<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <!-- 16,7% inset: het 512-canvas van het logo valt dan precies op het zichtbare deel (72 van 108 dp) -->
    <foreground>
        <inset
            android:drawable="@drawable/ic_spinflow_mark"
            android:inset="16.7%" />
    </foreground>
    <monochrome>
        <inset
            android:drawable="@drawable/ic_spinflow_mark"
            android:inset="16.7%" />
    </monochrome>
</adaptive-icon>
